{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Configuration d'équipement réseau",
  "type": "object",
  "required": ["device", "type", "management", "logging"],
  "properties": {
    "device": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "type": {"enum": ["router", "switch", "firewall"]},
    "zones": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["cidr"],
        "properties": {"cidr": {"type": "string"}, "sensitive": {"type": "boolean"}}
      }
    },
    "management": {
      "type": "object",
      "properties": {
        "ssh": {
          "type": "object", "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "version": {"type": "integer", "minimum": 1, "maximum": 2},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "idle_timeout": {"type": "integer", "minimum": 0},
            "allowed_sources": {"type": "array", "items": {"type": "string"}}
          }
        },
        "telnet":     {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
        "ftp":        {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
        "http_admin": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
        "snmp": {
          "type": "object", "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}, "version": {"enum": [1, "2c", 3]}, "community": {"type": "string"}}
        },
        "admin_password": {"type": "string"}
      }
    },
    "logging": {
      "type": "object", "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}, "server": {"type": "string"}}
    },
    "default_policy": {"enum": ["allow", "deny"]},
    "rules": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "action", "src", "dst"],
        "properties": {
          "id": {"type": "integer"},
          "action": {"enum": ["allow", "deny"]},
          "src": {"type": "string"},
          "dst": {"type": "string"},
          "port": {"type": ["integer", "string"]},
          "proto": {"enum": ["tcp", "udp", "icmp", "any"]},
          "log": {"type": "boolean"},
          "description": {"type": "string"}
        }
      }
    },
    "routing": {"type": "object"},
    "switch": {
      "type": "object",
      "properties": {
        "native_vlan": {"type": "integer"},
        "unused_ports_shutdown": {"type": "boolean"},
        "vlans": {"type": "array"}
      }
    }
  }
}
